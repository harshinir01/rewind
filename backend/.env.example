# Rewind Backend Configuration
# Copy this file to .env and fill in your values

# SQLite database path (default: ./rewind.db in the backend directory)
DATABASE_URL=sqlite:///./rewind.db

# Server configuration
HOST=0.0.0.0
PORT=8081
RELOAD=true

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000

# LLM Configuration (optional — diagnosis works without this using rule-based detection)
# Supported providers: google, openai, anthropic
LLM_PROVIDER=google
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=your_api_key_here
